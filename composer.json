{
    "name": "mayaracristina/jim-conversor-acessivel",
    "description": "PHP dependencies for the Jim - Conversor Acessivel WordPress plugin.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4",
        "smalot/pdfparser": "^2.9",
        "phpoffice/phpword": "^1.2",
        "woocommerce/action-scheduler": "^3.9"
    },
    "config": {
        "platform": {
            "php": "7.4"
        },
        "optimize-autoloader": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^2.1",
        "php-stubs/wordpress-stubs": "^6.6",
        "phpunit/phpunit": "^9.6",
        "brain/monkey": "^2.6"
    },
    "scripts": {
        "lint": [
            "phpcs"
        ],
        "analyse": [
            "phpstan analyse --no-progress --memory-limit=1G"
        ],
        "test": [
            "phpunit"
        ],
        "corpus": [
            "phpunit --testsuite corpus"
        ],
        "corpus:update": [
            "@putenv JIMCA_UPDATE_CORPUS=1",
            "phpunit --testsuite corpus"
        ],
        "qa": [
            "@lint",
            "@analyse",
            "@test"
        ]
    }
}
