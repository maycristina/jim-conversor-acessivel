msgid "Could not read the PDF. Common causes: corrupted file, password-protected or not standard PDF. Technical detail: %s"
msgstr "Das PDF konnte nicht gelesen werden. Häufige Ursachen: beschädigte Datei, passwortgeschützt oder nicht dem PDF-Standard entsprechend. Technische Details: %s"

msgid "Could not read the TXT file."
msgstr "Die TXT-Datei konnte nicht gelesen werden."

msgid "Could not read the Word document: %s"
msgstr "Das Word-Dokument konnte nicht gelesen werden: %s"

