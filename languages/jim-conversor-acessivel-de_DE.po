msgstr "%1$s hat mit einem Fehler geantwortet (HTTP %2$d): %3$s"

msgid "%1$s: %2$s"
msgstr "%1$s: %2$s"

msgid "%1$s: connection working. Model that answered: %2$s."
msgstr "%1$s: Verbindung funktioniert. Antwortendes Modell: %2$s."

